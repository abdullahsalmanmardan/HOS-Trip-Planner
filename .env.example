# Copy to .env and fill in. docker compose reads this file.

# Django
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Keep on in production behind HTTPS; off for plain-HTTP local runs.
SECURE_SSL_REDIRECT=False

# OpenRouteService (https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=

# Host port the app is published on.
APP_PORT=8000

# Frontend build arg. Empty means same origin, which is right when Django serves the frontend.
VITE_API_URL=

# Map tiles. Empty uses OpenStreetMap's tile servers, fine for development and light use.
# For production traffic use a keyed provider, e.g. MapTiler:
#   VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
#   VITE_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
